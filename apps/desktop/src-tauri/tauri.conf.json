{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Eolgae",
  "version": "1.0.0",
  "identifier": "com.pdfeolgae.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDF 얼개 (PDF Eolgae)",
        "width": 1380,
        "height": 960,
        "minWidth": 1120,
        "minHeight": 800,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../engine/pyproject.toml": "engine/pyproject.toml",
      "../../../engine/src": "engine/src"
    },
    "windows": {
      "nsis": {
        "languages": ["Korean", "English"]
      }
    }
  }
}
