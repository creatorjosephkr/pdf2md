{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Eolgae",
  "version": "1.0.0",
  "identifier": "com.pdfeolgae.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDF 얼개 (PDF Eolgae)",
        "width": 1380,
        "height": 960,
        "minWidth": 1120,
        "minHeight": 800,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../engine/pyproject.toml": "engine/pyproject.toml",
      "../../../engine/src": "engine/src"
    },
    "publisher": "creatorjosephkr",
    "copyright": "Copyright © 2026 creatorjosephkr",
    "shortDescription": "PDF 얼개 (PDF Eolgae) — Academic PDF to Markdown & RTF Studio",
    "longDescription": "100% local open-source desktop app converting academic PDFs into structured Markdown (.md) and formatted RTF (.rtf).",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "dmg": {
        "background": "dmg/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 185
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 185
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp"
      }
    }
  }
}
